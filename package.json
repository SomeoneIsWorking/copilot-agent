{
  "name": "branching-timeline-agent",
  "displayName": "Branching Timeline Agent",
  "description": "AI Agent with branching timeline, tool orchestration, and MCP support via vscode.lm",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.98.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "branchingTimeline.rewindToNode",
        "title": "Rewind to this node",
        "icon": "$(history)"
      },
      {
        "command": "branchingTimeline.renameSession",
        "title": "Rename session",
        "icon": "$(edit)"
      },
      {
        "command": "branchingTimeline.deleteSession",
        "title": "Delete session",
        "icon": "$(trash)"
      },
      {
        "command": "branchingTimeline.deleteCheckpoint",
        "title": "Delete checkpoint",
        "icon": "$(trash)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "branchingTimeline",
          "title": "Branching Timeline Agent",
          "icon": "resources/timeline.svg"
        }
      ]
    },
    "views": {
      "branchingTimeline": [
        {
          "id": "branchingTimeline.agentView",
          "name": "Agent",
          "type": "webview",
          "icon": "resources/timeline.svg"
        },
        {
          "id": "branchingTimeline.timelineView",
          "name": "Branching Timeline",
          "icon": "resources/timeline.svg"
        }
      ]
    },
    "menus": {
      "view/item/context": [
        {
          "command": "branchingTimeline.rewindToNode",
          "when": "view == branchingTimeline.timelineView && viewItem == timelineNode",
          "group": "inline@1"
        },
        {
          "command": "branchingTimeline.deleteCheckpoint",
          "when": "view == branchingTimeline.timelineView && viewItem == timelineNode",
          "group": "inline@2"
        },
        {
          "command": "branchingTimeline.renameSession",
          "when": "view == branchingTimeline.timelineView && viewItem == timelineSession",
          "group": "inline@1"
        },
        {
          "command": "branchingTimeline.deleteSession",
          "when": "view == branchingTimeline.timelineView && viewItem == timelineSession",
          "group": "inline@2"
        }
      ]
    },
    "configuration": {
      "title": "Branching Timeline Agent",
      "properties": {
        "branchingTimeline.models.smart": {
          "type": "string",
          "default": "gpt-5.3-codex",
          "description": "Model id/name for deeper planning and reasoning."
        },
        "branchingTimeline.models.fast": {
          "type": "string",
          "default": "gemini-3-flash",
          "description": "Model id/name for high-speed analysis/tool loops."
        },
        "branchingTimeline.toolApprovalMode": {
          "type": "string",
          "enum": [
            "ask",
            "auto"
          ],
          "default": "auto",
          "description": "Whether to require explicit confirmation before each native/MCP tool call."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p .",
    "watch": "tsc -watch -p .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "@types/vscode": "^1.98.0",
    "typescript": "^5.8.2",
    "vitest": "^2.1.8"
  }
}
