{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run Branching Timeline Extension",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}"
      ],
      "outFiles": [
        "${workspaceFolder}/out/**/*.js"
      ],
      "preLaunchTask": "npm: watch"
    },
    {
      "name": "Run Live Model Test (Auto)",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}"
      ],
      "outFiles": [
        "${workspaceFolder}/out/**/*.js"
      ],
      "env": {
        "BRANCHING_TIMELINE_AUTORUN_LIVE_TEST": "1",
        "BRANCHING_TIMELINE_LIVE_TEST_MODEL": "copilot-fast"
      },
      "preLaunchTask": "npm: watch"
    }
  ]
}
